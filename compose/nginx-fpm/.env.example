# FluxWP docker-wordpress: WordPress PHP-FPM + nginx + MariaDB + Redis object cache
# Copy to .env and fill in. Generate passwords with: openssl rand -base64 24

# Port on the host (put a reverse proxy with HTTPS in front for production).
HTTP_PORT=8080

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BUFFER_POOL_SIZE=256M
DB_MAX_CONNECTIONS=100

# Redis object cache
REDIS_PASSWORD=
REDIS_MAXMEMORY=128mb

# Automatic install (leave WP_ADMIN_EMAIL empty to use the install screen instead).
# Empty WP_ADMIN_PASSWORD = random password, printed once in `docker compose logs worker`.
WP_URL=http://localhost:8080
WP_TITLE=WordPress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=
WP_LOCALE=en_US
WP_TIMEZONE=UTC

# Install the Flux Setup plugin (FluxWP installer and updates).
FLUXWP_SETUP=false
# Optional custom zip address (default: updater.fluxwp.com, then the GitHub release).
FLUXWP_SETUP_URL=

# PHP
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_MAX_EXECUTION_TIME=300
PHP_OPCACHE_MEMORY=192
PHP_TIMEZONE=UTC
# PHP-FPM workers (each ~64 MB RAM).
PHP_FPM_MAX_CHILDREN=10

WP_ENVIRONMENT_TYPE=production
WP_CRON_INTERVAL=60
WORDPRESS_TABLE_PREFIX=wp_
