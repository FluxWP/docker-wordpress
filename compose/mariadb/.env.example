# FluxWP docker-wordpress: WordPress + MariaDB (Apache)
# Copy to .env and fill in. Generate passwords with: openssl rand -base64 24

# Port on the host (put a reverse proxy with HTTPS in front for production).
HTTP_PORT=8080

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BUFFER_POOL_SIZE=256M
DB_MAX_CONNECTIONS=100

# WordPress installs itself on first start. Empty WP_ADMIN_EMAIL becomes admin@<host>.
# Empty WP_ADMIN_PASSWORD is written to a file only the worker can read, not the logs:
#   docker compose exec worker cat /run/flx-private/admin-password
# Change the password after the first login, then delete the file:
#   docker compose exec worker rm /run/flx-private/admin-password
# WP_AUTO_INSTALL=false skips that. The install screen stays closed unless
# WP_INSTALL_TOKEN is alphanumeric (openssl rand -hex 24).
# Unset WP_INSTALL_TOKEN after the install is finished; a token in the query string can end up in the Apache access log.
WP_URL=http://localhost:8080
WP_TITLE=WordPress
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=
WP_AUTO_INSTALL=true
WP_INSTALL_TOKEN=
WP_LOCALE=en_US
WP_TIMEZONE=UTC

# Install the Flux Setup plugin (FluxWP installer and updates).
FLUXWP_SETUP=true
# Optional custom zip address (default: updater.fluxwp.com, then the GitHub release).
FLUXWP_SETUP_URL=
# Optional SHA-256 pin for that zip. Empty skips the pin.
FLUXWP_SETUP_SHA256=

# PHP
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_MAX_EXECUTION_TIME=300
PHP_OPCACHE_MEMORY=192
PHP_TIMEZONE=UTC
# Apache processes (each ~64 MB RAM).
APACHE_MAX_WORKERS=20

WP_ENVIRONMENT_TYPE=production
WP_CRON_INTERVAL=60
# Fast wake checks use only the shared filesystem, not PHP/WordPress.
WP_BACKGROUND_POLL_INTERVAL=2
WP_BACKGROUND_WORKERS_PER_PLUGIN=3
WP_BACKGROUND_MAX_PROCESSES=9
WORDPRESS_TABLE_PREFIX=wp_
